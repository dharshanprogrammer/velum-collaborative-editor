# Velum Production Client Environment Variables
# Set these in your Vercel Project Settings -> Environment Variables

# The public URL of your deployed backend service (e.g. on Render or Railway)
VITE_API_URL=https://your-velum-backend.onrender.com

# Optional: WebSocket endpoint (if omitted, automatically derived from VITE_API_URL)
VITE_WS_URL=wss://your-velum-backend.onrender.com
