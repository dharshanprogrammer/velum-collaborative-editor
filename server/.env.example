# Velum Production Server Environment Variables
# Set these in your Render / Railway Dashboard -> Environment Variables

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/velum?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/velum?retryWrites=true&w=majority

# Strong random secret for signing JWT auth tokens (e.g. generated via `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_super_secret_production_key_32_chars_min

# Your deployed Vercel frontend URL
CLIENT_URL=https://your-velum-app.vercel.app
